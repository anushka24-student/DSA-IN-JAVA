class Solution {
    public boolean isAnagram(String s, String t) {
        int str=s.length();
        int tr=t.length();
       
        if(str!=tr){
            return false;
        }
        char[] a=s.toCharArray();
        char[] b=t.toCharArray();
        Arrays.sort(a);
        Arrays.sort(b);
        for(int i=0;i<str;i++){
            if(a[i]!=b[i]){
                return false;
            }
        }
        return true;     
    }
}
