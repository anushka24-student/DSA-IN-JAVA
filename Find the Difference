class Solution {
    public char findTheDifference(String s, String t) {
        char a[]=s.toCharArray();
        char b[]=t.toCharArray();
        for(int i=0;i<b.length;i++){
            int found=0;
            for(int j=0;j<a.length;j++){
                 if(b[i]==a[j]){
                    found=1;
                    a[j]='*'; //replaces already same chars in a by '*'
                    break;
                 }
            }
            if(found==0){
                return b[i];
            }
        }
        return ' ' ;   //requires this line because java requires char function to return something
    }
}
