class Solution {
    public int lengthOfLastWord(String s) {
        int len = s.length();
        int count = 0;

        // skip trailing spaces
        int i = len - 1;
        while (i >= 0 && s.charAt(i) == ' ') {
            i--;
        }

        // count last word
        while (i >= 0 && s.charAt(i) != ' ') {
            count++;
            i--;
        }

        return count;
    }
}
