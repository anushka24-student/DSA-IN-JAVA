class Solution {
    public String reverseVowels(String s) {
        char a[]=s.toCharArray();
        int n=a.length;
        //char a[]=s.toCharArray();
        for(int i=0;i<n;i++){
            if(a[i]=='A' || a[i]=='E'|| a[i]=='O'|| a[i]=='U'||a[i]=='I'|| a[i]=='a'|| a[i]=='e' || a[i]=='i'|| a[i]=='o' || a[i]=='u'){
                for(int j=n-1;j>0;j--){
                    if(a[j]=='A' || a[j]=='E'|| a[j]=='O'|| a[j]=='U'||a[j]=='I'|| a[j]=='a'|| a[j]=='e' || a[j]=='i'|| a[j]=='o' || a[j]=='u'){
                        char temp=a[i];
                        a[i]=a[j];
                        a[j]=temp;

                        n=j;
                        break;
                    }
                }
            }
        }
        return new String(a);
    }
}
